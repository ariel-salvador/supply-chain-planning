# Copy to .env (gitignored) and replace the placeholders. Never commit .env.
ODOO_DB_USER=odoo
ODOO_DB_PASSWORD=change-me-db-password
ODOO_DB_NAME=pps_demo
# Password for the Odoo "admin" user inside the demo database (set by the init step)
ODOO_ADMIN_PASSWORD=change-me-admin-password
ODOO_URL=http://127.0.0.1:8069
